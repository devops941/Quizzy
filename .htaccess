Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
</IfModule>

# Block direct access to SQL files
<FilesMatch "\.sql$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block direct access to config directory
<IfModule mod_authz_core.c>
    <Files "db.php">
        Require all denied
    </Files>
</IfModule>
